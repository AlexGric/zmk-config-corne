#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define BASE 0
#define CONN 1
#define NUMB 2

//#define QWER 3

/ {
    behaviors {
        /*
		 * This executes a key combo
		 */

        Language_change: Language_change {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT &kp LEFT_ALT>;
            label = "LANGUAGE_CHANGE";
        };
    };

    macros {
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp TAB    &kp Q  &kp W  &kp E              &kp R  &kp T        &kp Y    &kp U  &kp I      &kp O    &kp P     &mt DEL BSPC
&kp LSHFT  &kp A  &kp S  &kp D              &kp F  &kp G        &kp H    &kp J  &kp K      &kp L    &kp SEMI  &kp SQT
&kp LCTRL  &kp Z  &kp X  &kp C              &kp V  &kp B        &kp N    &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp ESC
                         &mt LALT LEFT_WIN  &mo 2  &kp SPACE    &kp RET  &mo 1  &trans
            >;
        };

        connection_layer {
            bindings = <
&trans            &trans  &trans  &trans             &trans  &trans    &trans  &trans         &trans          &trans          &trans         &mt DELETE BACKSPACE
&kp LEFT_SHIFT    &trans  &trans  &trans             &trans  &trans    &trans  &mt HOME LEFT  &mt PG_DN DOWN  &mt PAGE_UP UP  &mt END RIGHT  &trans
&kp LEFT_CONTROL  &trans  &trans  &trans             &trans  &trans    &trans  &trans         &trans          &trans          &trans         &trans
                                  &mt LEFT_ALT LGUI  &mo 3   &trans    &trans  &trans         &trans
            >;
        };

        numbers_layer {
            bindings = <
&trans     &trans  &kp EQUAL  &kp N1    &kp N2  &kp N3       &trans     &trans     &trans     &trans      &trans      &mt DEL BSPC
&kp LSHFT  &trans  &kp MINUS  &kp N4    &kp N5  &kp N6       &trans     &kp GRAVE  &kp LBKT   &kp RBKT    &kp NUBS    &trans
&kp LCTRL  &trans  &kp N0     &kp N7    &kp N8  &kp N9       &mt F7 F1  &mt F8 F2  &mt F9 F3  &mt F10 F4  &mt F11 F5  &mt F12 F6
                              &kp LGUI  &trans  &kp SPACE    &trans     &trans     &trans
            >;
        };

        Connection {
            bindings = <
&trans          &trans        &trans      &trans      &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&bt BT_CLR_ALL  &bt BT_SEL 0  &bt BT_NXT  &bt BT_PRV  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans          &trans        &trans      &trans      &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                                          &trans      &trans  &trans    &trans  &trans  &trans
            >;
        };

        //  qwerty_layer {//3
        //
        //      bindings = <
        //      /*╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮*/
        //          &kp Q         &kp W         &kp E         &kp R         &kp T         &kp Y          &kp U         &kp I         &kp O         &kp P         &trans        &mt DEL BSPC
        //      /*├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤*/
        //          &kp A         &kp S         &kp D         &kp F         &kp G         &kp H          &kp J         &kp K         &kp L         &trans        &trans        &trans
        //      /*├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤*/
        //          &kp Z         &kp X         &kp C         &kp V         &kp B         &kp N          &kp M         &trans        &trans        &trans        &trans        &trans
        //      /*╰─────────────┴─────────────┴─────────────┼─────────────┼─────────────┼─────────────┤├─────────────┼─────────────┼─────────────┼─────────────┴─────────────┴─────────────╯*/
        //                                                    &trans        &mo UTIL      &kp SPACE      &trans        &trans        &trans
        //                                                /*╰─────────────┴─────────────┴─────────────╯╰─────────────┴─────────────┴─────────────╯*/                                      
        //      >;
        //  };
    };
};
